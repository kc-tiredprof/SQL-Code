SELECT DISTINCT
SPV.STPR_STUDENT-- [Student ID]
,SPV.STPR_ACAD_PROGRAM
,STPR_STATUS, STPR_START_DATE, STPR_END_DATE
FROM
dbo.STUDENTS_LS
INNER JOIN custom_insights.student_programs_view  SPV ON STUDENTS_ID = STPR_STUDENT AND STU_ACAD_PROGRAMS = STPR_ACAD_PROGRAM
INNER JOIN dbo.STPR_STATUSES ON SPV.STUDENT_PROGRAMS_ID = dbo.STPR_STATUSES.STUDENT_PROGRAMS_ID AND dbo.STPR_STATUSES.POS =1
INNER JOIN dbo.STPR_DATES ON SPV.STUDENT_PROGRAMS_ID = dbo.STPR_DATES.STUDENT_PROGRAMS_ID AND dbo.STPR_DATES.POS = 1
INNER JOIN dbo.PERSON ON STPR_STUDENT = ID
INNER JOIN dbo.PERSON_LS PLS ON PERSON.ID = PLS.ID
LEFT OUTER JOIN ADDRESS ON PERSON.PREFERRED_ADDRESS = ADDRESS.ADDRESS_ID
     LEFT OUTER JOIN ADDRESS_LS A1 ON ADDRESS.ADDRESS_ID = A1.ADDRESS_ID AND A1.POS = 1 AND A1.ADDRESS_LINES IS NOT NULL
     LEFT OUTER JOIN ADDRESS_LS A2 ON ADDRESS.ADDRESS_ID = A2.ADDRESS_ID AND A2.POS = 2 AND A2.ADDRESS_LINES IS NOT NULL
     LEFT OUTER JOIN PERPHONE P1 ON PERSON.ID = P1.ID AND P1.POS = 1
     LEFT OUTER JOIN PERPHONE P2 ON PERSON.ID = P2.ID AND P2.POS = 2
     LEFT OUTER JOIN dbo.PEOPLE_EMAIL PE1 ON PERSON.ID = PE1.ID AND PE1.PERSON_EMAIL_TYPES = 'KC'
	 LEFT OUTER JOIN dbo.PEOPLE_EMAIL PE2 ON PERSON.ID = PE2.ID AND PE2.PERSON_EMAIL_TYPES = 'PE'
	 LEFT OUTER JOIN dbo.ods_student_program_majors SMV ON SMV.STPR_STUDENT = SPV.STPR_STUDENT
	 LEFT OUTER JOIN STUDENT_ACAD_CRED ON SPV.STPR_STUDENT = STC_PERSON_ID
WHERE
--AND SPV.STPR_ACAD_PROGRAM LIKE 'CNEL%'
--AND [dbo].[K02_Get_Student_Most_Recent_Term](SPV.STPR_STUDENT) IN ('2022FA', '2022SU', '2023SP', '2022SP', '2021FA', '2021SU')
SPV.STPR_ACAD_PROGRAM != 'BAC.0101.DUAL'
AND SPV.STPR_ACAD_PROGRAM != 'NONC.0001.ENRL'
AND SPV.STPR_ACAD_PROGRAM != 'BAC.0101.ENRL'
AND SPV.STPR_ACAD_PROGRAM not like 'ABE%'
AND SPV.STPR_ACAD_PROGRAM not like 'VOCS%'
AND SPV.STPR_ACAD_PROGRAM not like 'NC%'
and dbo.STPR_STATUSES.POS = '1'
and stpr_status in ('G') and stpr_start_date <= '2026-05-01' and stpr_end_date > '2025-07-01'
and SPV.STPR_STUDENT in
(select distinct
sac.stc_person_id
from student_acad_cred sac
inner join stc_statuses ss on sac.student_acad_cred_id = ss.student_acad_cred_id and pos = '1'
left outer join grades on stc_verified_grade = grades_id
inner join terms on stc_term = terms_id  
inner join student_course_sec on stc_student_course_sec = student_course_sec_id  
where (stc_status in ('A', 'N') or (STC_STATUS = 'D' and GRD_GRADE = 'W'))
and stc_term in ('2025FA', '2025SU', '2026SP') )
